{
  "name": "petbell-backend",
  "version": "1.0.0",
  "description": "API RESTful do Petbell - Sistema de Alerta e Salvamento de Animais de Rua",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "prisma db push --skip-generate && node prisma/seed.js && node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "benchmark": "node scripts/performance-test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.19.0",
    "zod": "^3.23.8"
  },
  "keywords": [
    "petbell",
    "mvc",
    "express",
    "prisma",
    "mongodb",
    "zod",
    "jwt",
    "pwa"
  ],
  "author": "Equipe Petbell",
  "license": "MIT"
}
