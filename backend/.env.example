# Configuracoes de Ambiente do Servidor Petbell
NODE_ENV=development
PORT=3000

# Chave secreta de assinatura do JSON Web Token (JWT)
JWT_SECRET=petbell_chave_secreta_segura_jwt_2026_sorocaba_sp
JWT_EXPIRES_IN=24h

# Conexao com o Banco de Dados PostgreSQL (Local ou Nuvem)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_BANCO?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/petbell_db?schema=public"

# URL de Origem do Front-end para Politicas de CORS
FRONTEND_URL="http://localhost:4200"
