# Configuracoes de Ambiente do Servidor Petbell
NODE_ENV=development
PORT=3000

# Chave secreta de assinatura do JSON Web Token (JWT)
# Gere uma chave propria: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_aleatoria
JWT_EXPIRES_IN=24h

# Conexao com o Banco de Dados NoSQL MongoDB (Atlas - plano gratuito M0)
# O Prisma exige um replica set; o MongoDB Atlas ja vem configurado assim.
DATABASE_URL="mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/petbell_db?retryWrites=true&w=majority"

# URL de Origem do Front-end para Politicas de CORS (separe varias por virgula)
FRONTEND_URL="http://localhost:4200"

# Senha do usuario admin@petbell.org criado pelo seed (opcional; padrao: petbell123)
SEED_ADMIN_PASSWORD=
