// Definicao do Gerador do Prisma Client
generator client {
  provider = "prisma-client-js"
}

// Conexao com o banco de dados NoSQL MongoDB (MongoDB Atlas)
// Os relacionamentos e acoes de exclusao (SetNull/Cascade) sao emulados pelo Prisma.
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enumerador oficial de Status para Pets e Alertas
enum StatusPet {
  RESGATADO
  ADOTADO
  ADOCAO
  ABANDONADO
  PERDI_MEU_PET
}

// Documento de Usuario (Cidadao, ONG ou Administrador)
model Usuario {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  nome       String
  tipo       String    // "cidadao", "ong", "administrador"
  email      String    @unique
  senha_hash String
  telefone   String
  created_at DateTime  @default(now())

  // Relacionamentos opcionais (1 usuario pode ter varios pets e alertas)
  pets       Pet[]
  alertas    Alerta[]

  @@map("usuarios")
}

// Documento de Perfil do Pet
model Pet {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  nome       String?
  especie    String?
  raca       String?
  idade      Int?
  foto_url   String?
  status_pet StatusPet  @default(ABANDONADO)
  created_at DateTime   @default(now())

  // Referencia opcional: permite criacao de alerta de animal sem usuario cadastrado
  usuario_id String?    @db.ObjectId
  usuario    Usuario?   @relation(fields: [usuario_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  // Relacionamento com Alertas associados a este Pet
  alertas    Alerta[]

  @@map("pets")
}

// Documento de Alerta de Ocorrencia de Animal
model Alerta {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  titulo      String
  descricao   String
  localizacao String
  latitude    Float
  longitude   Float
  foto_url    String?
  status_pet  StatusPet            @default(ABANDONADO)
  created_at  DateTime             @default(now())

  // Referencia opcional: permite geracao rapida de alerta sem cadastro previo
  usuario_id  String?              @db.ObjectId
  usuario     Usuario?             @relation(fields: [usuario_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  // Vinculo opcional com a colecao de Pets
  pet_id      String?              @db.ObjectId
  pet         Pet?                 @relation(fields: [pet_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Mensagens do chat comunitario deste alerta
  mensagens   MensagemComunidade[]

  @@index([latitude, longitude], name: "idx_alerta_coordenadas")
  @@index([created_at])
  @@map("alertas")
}

// Documento do Chat Comunitario do Alerta (evita exposicao de telefones publicos)
model MensagemComunidade {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  alerta_id  String   @db.ObjectId
  alerta     Alerta   @relation(fields: [alerta_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  autor_nome String
  autor_tipo String   @default("comunidade") // "comunidade", "ong", "tutor"
  conteudo   String
  created_at DateTime @default(now())

  @@map("mensagens_comunidade")
}
